{
   "name": "RentFlow",
   "version": "1.0.0",
   "description": "Slovak long-term rental calculator and landlord tools - API",
   "type": "module",
   "main": "dist/index.js",
   "directories": {
      "doc": "docs"
   },
   "scripts": {
      "dev": "tsx watch src/index.ts",
      "build": "prisma generate && tsc",
      "start": "node dist/index.js",
      "typecheck": "tsc --noEmit",
      "db:migrate": "prisma migrate dev",
      "db:deploy": "prisma migrate deploy",
      "db:studio": "prisma studio",
      "db:reset": "prisma migrate reset",
      "db:generate": "prisma generate"
   },
   "repository": {
      "type": "git",
      "url": "git+https://github.com/g-code-sk/RentFlow.git"
   },
   "keywords": [],
   "author": "",
   "license": "ISC",
   "bugs": {
      "url": "https://github.com/g-code-sk/RentFlow/issues"
   },
   "homepage": "https://github.com/g-code-sk/RentFlow#readme",
   "dependencies": {
      "@prisma/adapter-pg": "^7.10.1",
      "@prisma/client": "^7.10.1",
      "dotenv": "^18.0.9",
      "express": "^5.3.0",
      "pg": "^8.23.1",
      "zod": "^4.6.7"
   },
   "devDependencies": {
      "@types/express": "^5.0.6",
      "@types/node": "^26.6.5",
      "@types/pg": "^8.23.1",
      "prisma": "^7.10.1",
      "tsx": "^4.23.15",
      "typescript": "^7.0.2"
   }
}
