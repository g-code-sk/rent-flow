# Local Homebrew Postgres (Valet-style). Replace YOUR_MAC_USER with `whoami`.
# Prisma reads this from prisma.config.ts (not schema.prisma).
DATABASE_URL="postgresql://YOUR_MAC_USER@localhost:5432/rentflow"

# Render: paste the Internal Database URL from the Postgres instance (includes sslmode).
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/rentflow?sslmode=require"

PORT=3000
CORS_ORIGIN=http://localhost:5173
