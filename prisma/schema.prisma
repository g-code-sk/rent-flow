generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model WaitlistEmail {
  id          String   @id @default(uuid())
  email       String   @unique
  source      String
  consentedAt DateTime @map("consented_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("waitlist_emails")
}

model Feedback {
  id        String   @id @default(uuid())
  body      String
  email     String?
  path      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("feedback")
}
